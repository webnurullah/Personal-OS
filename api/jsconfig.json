{
  // Type-checks the JavaScript (npm run check). Nothing is compiled; Node runs the .js files as they are.
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["app.js", "src/**/*.js", "src/types/*.d.ts", "test/**/*.js"]
}
