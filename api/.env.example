# For running the API on your computer: copy this file to .env and fill in the values.
# On Vercel, add the same names under Project → Settings → Environment Variables instead.

# Supabase → Project Settings → Data API (Project URL) and API Keys
SUPABASE_URL=https://your-project-id.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Never put the secret/service_role key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# The web app's address(es), comma separated, without a trailing slash.
CORS_ORIGINS=http://localhost:3000,https://pos.nurullah.com.bd

# Leave empty (the API has its own domain, https://api.nurullah.com.bd).
BASE_PATH=

# Local development only (Vercel does not use these).
PORT=4000
NODE_ENV=development
