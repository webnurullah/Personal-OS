# Copy this file to .env and fill in the values.
# On cPanel you can instead add them under "Setup Node.js App" → Environment variables.

# Supabase → Project Settings → API (or "Connect")
SUPABASE_URL=https://your-project-id.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Never put the secret/service_role key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# The web app's address(es), comma separated, without a trailing slash.
CORS_ORIGINS=http://localhost:3000,https://pos.nurullah.com.bd

# Leave empty when the API has its own subdomain (https://api.nurullah.com.bd).
# Use /api if cPanel serves the app at https://nurullah.com.bd/api.
BASE_PATH=

# Local development only (cPanel chooses the port itself).
PORT=4000
NODE_ENV=development
