# Copy this file to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables (same names).

# Supabase → the "Connect" button (or Project Settings → Data API and API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
