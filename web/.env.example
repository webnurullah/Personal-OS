# Copy this file to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables (same names).

# Supabase → Project Settings → API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Where the Node.js API runs (no trailing slash).
# Local: http://localhost:4000   Live: https://api.nurullah.com.bd
NEXT_PUBLIC_API_URL=http://localhost:4000
